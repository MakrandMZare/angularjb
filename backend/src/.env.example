DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-user
SMTP_PASSWORD=replace-with-your-smtp-password
SMTP_FROM=Your App <your-email@example.com>

FIREBASE_PROJECT_ID=janbazar-auth
FIREBASE_DEFAULT_COUNTRY_CODE=91
# Optional when Application Default Credentials are not configured:
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\outside\repository\service-account.json
